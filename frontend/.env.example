# Use "catalog" to expose only the Home and Products pages and hide pricing.
# Leave unset or use "full" for the complete customer and staff application.
NEXT_PUBLIC_APP_MODE=full

NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

NEXT_PUBLIC_REVERB_APP_KEY=your-local-reverb-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
